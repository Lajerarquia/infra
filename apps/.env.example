# Copia este archivo como .env (en la EC2: ~/gymflow/infra/apps/.env) y completa los valores.
# El .env está en .gitignore: NUNCA se sube al repositorio. La contraseña real solo vive en la EC2.

# --- Azure AD (App Registration "GymFlow"; tenant y client id no son secretos) ---
AZURE_TENANT_ID=6a3e6e0e-c7e4-4a0a-9a66-1778df0b3b19
AZURE_CLIENT_ID=ee1bba85-7f98-4977-bf8b-f6acebb7ec6f

# --- Amazon RDS PostgreSQL 17 (instancia gymflow-db, base gymflow) ---
DB_URL=jdbc:postgresql://<endpoint-rds>:5432/gymflow?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<contraseña>
# "update" crea las tablas la primera vez; luego se puede usar "validate".
JPA_DDL_AUTO=update

# --- URLs internas (nombres de los servicios en la red de Docker Compose) ---
RESERVATIONS_URL=http://ms-gymflow-reservations:8081
CATALOG_URL=http://ms-gymflow-catalog:8082

# --- CORS del BFF (orígenes separados por coma). Detrás del API Gateway el preflight lo responde el Gateway ---
GYMFLOW_CORS_ORIGINS=http://localhost:4200
