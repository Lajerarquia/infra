# Copia este archivo como .env (en la EC2: ~/gymflow/infra/kafka/.env) y completa los valores.
# El .env está en .gitignore: NUNCA se sube al repositorio.

# Dirección que los brokers ANUNCIAN a los clientes externos (listener EXTERNAL, puertos 9092/9093/9094).
#   - En AWS: la IP PRIVADA de ec2-kafka (los microservicios de ec2-apps llegan por la red privada de la VPC).
#   - En local (Docker Desktop): localhost
# Si aquí va una dirección que el cliente no puede alcanzar, el cliente se conecta al primer broker, recibe esa
# dirección en los metadatos y después falla al producir o consumir.
KAFKA_ADVERTISED_HOST=<ip-privada-ec2-kafka>

# Login de Kafka UI (http://<ip-elastica-ec2-kafka>:8080).
KAFKA_UI_USER=gymflow
KAFKA_UI_PASSWORD=<contraseña>
