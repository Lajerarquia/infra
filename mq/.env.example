# Copia este archivo como .env (en la EC2: ~/gymflow/infra/mq/.env) y completa los valores.
# El .env está en .gitignore: NUNCA se sube al repositorio.

# Usuario de las aplicaciones y de la Management UI. No se usa "guest": RabbitMQ solo lo acepta desde localhost,
# así que desde ec2-apps la conexión sería rechazada.
RABBITMQ_DEFAULT_USER=gymflow
RABBITMQ_DEFAULT_PASS=<contraseña>

# Secreto compartido por los dos nodos del clúster (mismo valor en ambos). Solo letras y números, 20+ caracteres.
# Ejemplo para generarlo: openssl rand -hex 24
RABBITMQ_ERLANG_COOKIE=<cookie>
